{
  "name": "@gavant/ember-bootstrap-dropdown",
  "version": "4.0.0-0",
  "description": "Dropdown menus built on ember-basic-dropdown, and styled by Bootstrap 4.",
  "keywords": [
    "ember-addon",
    "bootstrap",
    "dropdown"
  ],
  "repository": "https://github.com/Gavant/gavant-ember-bootstrap-dropdown",
  "author": "Gavant Software, Inc.",
  "license": "MIT",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "rollup --config",
    "lint": "concurrently 'npm:lint:*(!fix)' --names 'lint:'",
    "lint:fix": "concurrently 'npm:lint:*:fix' --names 'fix:'",
    "lint:hbs": "ember-template-lint . --no-error-on-unmatched-pattern",
    "lint:js": "eslint . --cache",
    "lint:hbs:fix": "ember-template-lint . --fix --no-error-on-unmatched-pattern",
    "lint:js:fix": "eslint . --fix",
    "start": "rollup --config --watch",
    "test": "echo 'A v2 addon does not have tests, run tests in test-app'",
    "prepublishOnly": "rollup --config"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.0.0"
  },
  "peerDependencies": {
    "ember-basic-dropdown": "^8.6.0",
    "ember-source": ">= 3.24.0"
  },
  "devDependencies": {
    "@babel/core": "^7.18.2",
    "@babel/plugin-proposal-class-properties": "^7.17.12",
    "@babel/plugin-proposal-decorators": "^7.18.2",
    "@babel/plugin-proposal-private-methods": "^7.16.11",
    "@babel/plugin-transform-runtime": "^7.16.10",
    "@babel/plugin-transform-typescript": "^7.16.8",
    "@babel/plugin-transform-class-static-block": "7.26.0",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-typescript": "^7.17.12",
    "@babel/runtime": "^7.16.7",
    "@embroider/addon-dev": "^1.7.1",
    "@gavant/glint-template-types": "^0.2.6",
    "@glint/core": "^0.9.2",
    "@glint/environment-ember-loose": "^0.9.2",
    "@rollup/plugin-babel": "^5.3.1",
    "@types/ember-data": "^4.4.6",
    "@types/ember-data__adapter": "^4.0.1",
    "@types/ember-data__model": "^4.0.0",
    "@types/ember-data__serializer": "^4.0.1",
    "@types/ember-data__store": "^4.0.2",
    "@types/ember-resolver": "^5.0.13",
    "@types/ember__application": "^4.0.4",
    "@types/ember__array": "^4.0.3",
    "@types/ember__component": "^4.0.11",
    "@types/ember__controller": "^4.0.3",
    "@types/ember__debug": "^4.0.3",
    "@types/ember__destroyable": "^4.0.1",
    "@types/ember__engine": "^4.0.4",
    "@types/ember__error": "^4.0.1",
    "@types/ember__object": "^4.0.5",
    "@types/ember__owner": "^4.0.2",
    "@types/ember__polyfills": "^4.0.1",
    "@types/ember__routing": "^4.0.12",
    "@types/ember__runloop": "^4.0.2",
    "@types/ember__service": "^4.0.1",
    "@types/ember__string": "^3.0.10",
    "@types/ember__template": "^4.0.1",
    "@types/ember__test": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^5.18.0",
    "@typescript-eslint/parser": "^5.18.0",
    "babel-eslint": "^10.1.0",
    "ember-basic-dropdown": "^8.6.0",
    "ember-template-lint": "^4.3.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-ember": "^10.5.9",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-qunit": "^7.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.6.1",
    "release-it": "^14.14.0",
    "rollup": "^2.78.1",
    "rollup-plugin-ts": "^3.0.2",
    "typescript": "^4.8.2"
  },
  "typings": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ],
      "components/dropdown-action": [
        "dist/components/dropdown-action/index.d.ts"
      ],
      "components/dropdown-link": [
        "dist/components/dropdown-link/index.d.ts"
      ],
      "components/dropdown-menu": [
        "dist/components/dropdown-menu/index.d.ts"
      ],
      "glint": [
        "dist/glint.d.ts"
      ]
    }
  },
  "engines": {
    "node": "14.* || >= 16"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.js",
    "app-js": {
      "./components/dropdown-action/index.js": "./dist/_app_/components/dropdown-action/index.js",
      "./components/dropdown-link/index.js": "./dist/_app_/components/dropdown-link/index.js",
      "./components/dropdown-menu/index.js": "./dist/_app_/components/dropdown-menu/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*",
    "./addon-main.js": "./addon-main.js"
  },
  "volta": {
    "extends": "../package.json"
  }
}
